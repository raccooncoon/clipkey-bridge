// secrets.h 로 복사한 뒤 실제 값을 넣는다. secrets.h 는 .gitignore 에 포함되어 커밋되지 않는다.
#pragma once

struct WifiNetwork {
  const char* ssid;
  const char* password;
};

// 부팅/재접속 시 스캔해서 목록 중 신호가 가장 좋은 곳에 붙는다. 2.4GHz 만 지원한다.
constexpr WifiNetwork WIFI_NETWORKS[] = {
    {"home-ssid", "home-password"},
    {"office-ssid", "office-password"},
    {"phone-hotspot-ssid", "hotspot-password"},
};

// openssl rand -hex 16 등으로 생성. 송신기의 CLIPKEY_TOKEN 환경변수와 같은 값.
#define CLIPKEY_TOKEN "replace-with-device-token"

// true 면 송신기가 autoStart=true 로 보낸 작업을 버튼 없이 2초 뒤 자동 입력한다 (그 2초 동안 BOOT = 취소).
// 같은 Wi-Fi 에서 토큰을 아는 누구나 입력할 수 있게 되므로 혼자 쓰는 환경에서만 켠다.
#define CLIPKEY_ALLOW_AUTO_START false
